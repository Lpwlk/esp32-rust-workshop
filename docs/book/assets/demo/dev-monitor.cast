[0.107, "o", "\u001b[38;5;247m[03:18:31]\u001b[0m\u001b[38;5;247m \u001b[0m\u001b[38;5;68mINFO    \u001b[0m node A \u2192 board \u001b[3;33m21:FE\u001b[0m on \u001b[3;33m/dev/cu.usbmodem11201\u001b[0m                                             \r\n"]
[0.14, "o", "\u001b[38;5;247m[03:18:31]\u001b[0m\u001b[38;5;247m \u001b[0m\u001b[38;5;68mINFO    \u001b[0m Ctrl+C to quit \u00b7 the board is reset so that its boot card shows (`--keep` to attach as it \r\n\u001b[38;5;247m           \u001b[0m         is)                                                                                       \r\n"]
[0.141, "o", "\u001b[38;5;247m[03:18:31]\u001b[0m\u001b[38;5;247m \u001b[0m\u001b[38;5;68mINFO    \u001b[0m \u001b[3;38;5;247m$ espflash monitor --chip esp32s31 --port /dev/cu.usbmodem11201 --skip-update-check --elf \u001b[0m\r\n\u001b[38;5;247m           \u001b[0m         \u001b[3;38;5;247mfirmware/ethernet/target/riscv32imafc-unknown-none-elf/release/node-a\u001b[0m                     \r\n"]
[0.142, "o", "\u001b[90m[\u001b[0m2026-11-26T02:18:31Z \u001b[32mINFO \u001b[0m\u001b[90m]\u001b[0m Serial port: '/dev/cu.usbmodem11201'\r\n\u001b[90m[\u001b[0m2026-11-26T02:18:31Z \u001b[32mINFO \u001b[0m\u001b[90m]\u001b[0m Connecting...\r\n"]
[1.757, "o", "\u001b[90m     0.405\u001b[0m  \u001b[37m\u00b7\u001b[0m \u001b[0madc-stream \u00b7 ESP32-S31 \u00b7 MAC 1c:29:04:d0:21:01\u001b[0m\r\n\u001b[90m     0.406\u001b[0m  \u001b[37m\u00b7\u001b[0m \u001b[0mbuild 7c83c25 (main) \u00b7 2026-11-26 02:18:20 UTC\u001b[0m\r\n"]
[1.757, "o", "\u001b[90m     0.406\u001b[0m  \u001b[37m\u00b7\u001b[0m \u001b[0mGPIO43 (ADC1 channel 1) \u00b7 continuous mode with DMA \u00b7 611 to 83333 Hz\u001b[0m\r\n"]
[1.758, "o", "\u001b[90m     0.407\u001b[0m  \u001b[37m\u00b7\u001b[0m \u001b[0mUDP 192.168.77.20:7100 \u00b7 static address, no DHCP\u001b[0m\r\n"]
[1.758, "o", "\u001b[90m     0.407\u001b[0m  \u001b[37m\u00b7\u001b[0m \u001b[0mpotentiometer on GPIO44 (ADC1 channel 2) \u00b7 off until `pot freq` or `pot duty`\u001b[0m\r\n"]
[1.759, "o", "\u001b[90m     0.408\u001b[0m  \u001b[37m\u00b7\u001b[0m \u001b[0mPWM generator on GPIO20 (RMT) \u00b7 0.2 Hz to 1000 kHz \u00b7 off until `pwm`\u001b[0m\r\n"]
[1.759, "o", "\u001b[90m     0.409\u001b[0m  \u001b[37m\u00b7\u001b[0m \u001b[0mwaiting for the Ethernet link\u2026\u001b[0m\r\n"]
[4.261, "o", "\u001b[90m     2.910\u001b[0m  \u001b[32m\u2713\u001b[0m \u001b[0mlink up \u00b7 1000 Mbit/s \u00b7 full duplex\u001b[0m\r\n"]
[5.915, "o", "\u001b[90m     4.564\u001b[0m  \u001b[37m\u00b7\u001b[0m \u001b[0mADC1 and the LP-GDMA channel set up\u001b[0m\r\n"]
[5.916, "o", "\u001b[90m     4.565\u001b[0m  \u001b[32m\u2713\u001b[0m \u001b[0mclient 192.168.77.12:57200 \u00b7 75188.0 Hz (asked 75000) \u00b7 256 samples/datagram \u00b7 294 datagrams/s \u00b7 1.25 Mbit/s\u001b[0m\r\n"]
