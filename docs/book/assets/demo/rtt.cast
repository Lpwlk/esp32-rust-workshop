[5.585, "o", "\u001b[1G\u001b[1G\u001b[38;5;2m\u001b[1mcli> \u001b[0m\u001b[1G\u001b[6G\u001b[1G\u001b[J\u001b[36m\u2502\u001b[0m  \u001b[90mreset     \u001b[0mCoreUsbUart (rst 0x17)                            \u001b[36m\u2502\u001b[0m\n\u001b[1G\u001b[36m\u2502\u001b[0m  \u001b[90mTRNG      \u001b[0m0xC655CF4A 0x896B7084 0xED355C81                  \u001b[36m\u2502\u001b[0m\n\u001b[1G\u001b[36m\u251c\u2500 \u001b[1mrgb led\u001b[0m\u001b[36m \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\u001b[0m\n\u001b[1G\u001b[36m\u2502\u001b[0m  \u001b[90mpattern   \u001b[0m\u001b[38;2;255;25;77m\u2588\u001b[38;2;255;32;86m\u2588\u001b[38;2;255;52;107m\u2588\u001b[38;2;255;76;130m\u2588\u001b[38;2;255;88;142m\u2588\u001b[38;2;235;83;157m\u2588\u001b[38;2;194;71;194m\u2588\u001b[38;2;157;61;235m\u2588\u001b[38;2;142;56;255m\u2588\u001b[38;2;157;69;244m\u2588\u001b[38;2;194;100;221m\u2588\u001b[38;2;235;138;199m\u2588\u001b[38;2;255;157;190m\u2588\u001b[38;2;255;129;169m\u2588\u001b[38;2;255;77;127m\u2588\u001b[38;2;255;38;91m\u2588\u001b[0m sakura                           \u001b[36m\u2502\u001b[0m\n\u001b[1G\u001b[36m\u2502\u001b[0m  \u001b[90mtiming    \u001b[0m50 Hz refresh \u00b7 500 ms cycle \u00b7 40%                \u001b[36m\u2502\u001b[0m\n"]
