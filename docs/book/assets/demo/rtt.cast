[5.501, "o", "\u001b[1G\u001b[1G\u001b[38;5;2m\u001b[1mcli> \u001b[0m\u001b[1G\u001b[6G\u001b[1G\u001b[J\n\u001b[1G\u001b[36m\u256d\u2500 \u001b[1mlink \u00b7 shared, must match on both nodes\u001b[0m\u001b[36m \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\u001b[0m\n\u001b[1G\u001b[36m\u2502\u001b[0m  \u001b[90muart      \u001b[0mUART1 \u00b7 5 Mbaud \u00b7 8N1 \u00b7 RX by interrupt           \u001b[36m\u2502\u001b[0m\n\u001b[1G\u001b[36m\u2502\u001b[0m  \u001b[90mformat    \u001b[0m$TYPE,node,seq,t_ms,\u2026*XOR  (NMEA-style)           \u001b[36m\u2502\u001b[0m\n\u001b[1G\u001b[36m\u2502\u001b[0m  \u001b[90mframes    \u001b[0mDAT (periodic) \u00b7 EVT + 64-bit key per edge        \u001b[36m\u2502\u001b[0m\n\u001b[1G\u001b[36m\u251c\u2500 \u001b[1mnode \u00b7 this board's config\u001b[0m\u001b[36m \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\u001b[0m\n\u001b[1G\u001b[36m\u2502\u001b[0m  \u001b[90mname      \u001b[0mnode-A                                            \u001b[36m\u2502\u001b[0m\n\u001b[1G\u001b[36m\u2502\u001b[0m  \u001b[90mboard     \u001b[0mESP32-S31-Function-CoreBoard-1                    \u001b[36m\u2502\u001b[0m\n\u001b[1G\u001b[36m\u2502\u001b[0m  \u001b[90muart io   \u001b[0mTX GPIO2 \u00b7 RX GPIO3                               \u001b[36m\u2502\u001b[0m\n\u001b[1G\u001b[36m\u2502\u001b[0m  \u001b[90mDAT       \u001b[0mevery 2 s (0.5 Hz) \u00b7 tx periodic                  \u001b[36m\u2502\u001b[0m\n"]
[5.544, "o", "\u001b[1G\u001b[36m\u2502\u001b[0m  \u001b[90mstatus    \u001b[0mstats line every 5 s                              \u001b[36m\u2502\u001b[0m\n\u001b[1G\u001b[36m\u2502\u001b[0m  \u001b[90mtimeout   \u001b[0mlink DOWN after 3 peer periods                    \u001b[36m\u2502\u001b[0m\n\u001b[1G\u001b[36m\u2502\u001b[0m  \u001b[90mbutton    \u001b[0mjumper GPIO4 + BOOT GPIO61 \u00b7 IRQ on both edges    \u001b[36m\u2502\u001b[0m\n\u001b[1G\u001b[36m\u2502\u001b[0m  \u001b[90mfilter    \u001b[0m30 ms debounce \u00b7 150 ms lockout                   \u001b[36m\u2502\u001b[0m\n\u001b[1G\u001b[36m\u251c\u2500 \u001b[1mbuild\u001b[0m\u001b[36m \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\u001b[0m\n\u001b[1G\u001b[36m\u2502\u001b[0m  \u001b[90mfirmware  \u001b[0mesp32-rust-workshop v0.1.0                        \u001b[36m\u2502\u001b[0m\n"]
