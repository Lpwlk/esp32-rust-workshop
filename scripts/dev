#!/bin/sh
# `dev build -v` instead of `python3 scripts/dev.py build -v`.
#
# Runs scripts/dev.py with the Python of the repository's .venv (so the script doesn't have to
# start the system Python first and relaunch itself), and from any folder. Before the .venv
# exists, it takes the first Python 3.13 or newer it finds (dev.py creates the .venv).
#
# Put it on your PATH once, e.g.:   ln -s "$PWD/scripts/dev" ~/.local/bin/dev
# (a symlink is followed back to the repository, so it keeps working from anywhere).

src=$0
while [ -L "$src" ]; do
    dir=$(cd "$(dirname "$src")" && pwd)
    src=$(readlink "$src")
    case $src in /*) ;; *) src=$dir/$src ;; esac
done
root=$(cd "$(dirname "$src")/.." && pwd)

if [ -x "$root/.venv/bin/python" ]; then
    exec "$root/.venv/bin/python" "$root/scripts/dev.py" "$@"
fi
for python in python3.13 python3.14 python3; do
    if command -v "$python" >/dev/null 2>&1 && "$python" -c 'import sys; sys.exit(sys.version_info < (3, 13))' 2>/dev/null; then
        exec "$python" "$root/scripts/dev.py" "$@"
    fi
done
echo "dev needs Python 3.13 or newer: https://www.python.org/downloads/" >&2
exit 1
