#!/bin/sh
# `dev build -v` instead of `python3 scripts/dev.py build -v`.
#
# Runs scripts/dev.py with the Python of the repository's .venv (so the script doesn't have to
# start the system Python first and relaunch itself), and from any folder. Before `dev setup`
# has created the .venv, it falls back on python3.
#
# Put it on your PATH once, e.g.:   ln -s "$PWD/scripts/dev" ~/.local/bin/dev
# (a symlink is followed back to the repository, so it keeps working from anywhere).

src=$0
while [ -L "$src" ]; do
    dir=$(cd "$(dirname "$src")" && pwd)
    src=$(readlink "$src")
    case $src in /*) ;; *) src=$dir/$src ;; esac
done
root=$(cd "$(dirname "$src")/.." && pwd)

if [ -x "$root/.venv/bin/python" ]; then
    exec "$root/.venv/bin/python" "$root/scripts/dev.py" "$@"
fi
exec python3 "$root/scripts/dev.py" "$@"
